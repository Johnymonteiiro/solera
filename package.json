{
  "name": "solera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:migrate-json": "dotenv -e .env.local -- tsx scripts/migrate-threads-to-db.ts",
    "db:apply": "dotenv -e .env.local -- tsx scripts/apply-sql.ts",
    "db:check": "dotenv -e .env.local -- tsx scripts/check-db.ts",
    "db:backfill-owner": "dotenv -e .env.local -- tsx scripts/backfill-owner.ts",
    "db:import-config": "dotenv -e .env.local -- tsx scripts/import-config.ts",
    "test:pairs": "dotenv -e .env.local -- tsx --tsconfig tsconfig.json scripts/test-revision-pairs.ts",
    "test:sample-rule": "tsx --tsconfig tsconfig.json scripts/test-sample-rule.ts",
    "study:exclude": "dotenv -e .env.local -- tsx --tsconfig tsconfig.json scripts/study-exclude.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.1.39",
    "@langchain/langgraph": "^1.2.8",
    "@langchain/openai": "^1.4.4",
